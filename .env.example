# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# Ollama
OLLAMA_HOST=http://localhost:11434

# Models
#GRAPH_EXTRACTION_MODEL=qwen2.5:3b
GRAPH_EXTRACTION_MODEL=qwen2.5:7b
#ANSWER_MODEL=llama-3.1-8b-instant
#ANSWER_MODEL=qwen3:8b
#ANSWER_MODEL=qwen3.5:4b
#ANSWER_MODEL=qwen2.5:3b
ANSWER_MODEL=qwen2.5:7b
GROUND_TRUTH_MODEL=qwen2.5:7b
#GROUND_TRUTH_MODEL=qwen3:8b

# Whisper
WHISPER_MODEL_SIZE=base
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5

# Groq (optional - set USE_GROQ=true to use hosted inference instead of Ollama)
USE_GROQ=false
#GROQ_API_KEY=your_groq_api_key_here

# Benchmark
BENCHMARK_RESUME=false
